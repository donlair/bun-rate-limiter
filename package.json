{
  "name": "bun-rate-limiter",
  "version": "0.1.1",
  "description": "A modern, modular rate limiter and concurrency queue. Built with Bun, runs anywhere—Node.js 18+, Vercel, AWS Lambda, and more.",
  "keywords": [
    "queue",
    "concurrency",
    "rate-limit",
    "throttle",
    "async",
    "promise",
    "bun",
    "node",
    "nodejs",
    "vercel",
    "serverless",
    "lambda",
    "redis",
    "distributed"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Don Lair <don.lair@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donlair/bun-rate-limiter.git"
  },
  "bugs": {
    "url": "https://github.com/donlair/bun-rate-limiter/issues"
  },
  "homepage": "https://github.com/donlair/bun-rate-limiter#readme",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=18.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun run build:types && bun run build:types:rewrite && bun run build:esm && bun run build:cjs",
    "build:types": "tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist",
    "build:types:rewrite": "bun run scripts/rewrite-dts-imports.ts",
    "build:esm": "bun build src/index.ts --outdir dist --target node --format esm",
    "build:cjs": "bun build src/index.ts --outfile dist/index.cjs --target node --format cjs",
    "test": "bun test ./tests",
    "test:watch": "bun test --watch ./tests",
    "test:coverage": "bun test --coverage ./tests",
    "lint": "biome lint --write src tests",
    "format": "biome format --write src tests",
    "check": "biome check src tests",
    "ci": "biome ci src tests",
    "prepack": "bun run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun test ./tests && bun run build && npm publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@changesets/cli": "^2.29.8",
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.4"
}
